# The API only accepts repositories below these roots. Separate roots with ; on Windows or : on Unix.
REPOPILOT_ALLOWED_ROOTS=D:\code
REPOPILOT_DATABASE_PATH=.repopilot/repopilot.db

# offline is deterministic and requires no network. openai_compatible enables an LLM planner.
REPOPILOT_PROVIDER=offline
REPOPILOT_API_BASE=https://api.openai.com/v1
REPOPILOT_API_KEY=
REPOPILOT_MODEL=

REPOPILOT_SANDBOX_MODE=local
REPOPILOT_DOCKER_IMAGE=repopilot:latest
REPOPILOT_TIMEOUT_SECONDS=120
REPOPILOT_MAX_STEPS=16
